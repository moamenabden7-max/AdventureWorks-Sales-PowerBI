table 'Product Categories Lookup'
	lineageTag: ece0c90a-aea1-4bd6-8800-32ba6c8fc0b2

	column ProductCategoryKey
		dataType: int64
		formatString: 0
		lineageTag: da472ffc-604c-4c19-9040-71418231d4b6
		summarizeBy: none
		sourceColumn: ProductCategoryKey

		annotation SummarizationSetBy = Automatic

	column CategoryName
		dataType: string
		lineageTag: dd7ccb42-ad19-454a-8963-b11e2865d1ad
		summarizeBy: none
		sourceColumn: CategoryName

		annotation SummarizationSetBy = Automatic

	partition 'Product Categories Lookup' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(File.Contents(DataFolder & "/Product Categories Lookup.csv.gz"), Compression.GZip), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"ProductCategoryKey", Int64.Type}, {"CategoryName", type text}}, "en-US")
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

