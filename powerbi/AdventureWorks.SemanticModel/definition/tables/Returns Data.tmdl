table 'Returns Data'
	lineageTag: 4975bb15-2414-4d1a-a180-4629605d698b

	column ReturnDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: abcabae6-de90-47ec-be18-eb5df5794d60
		summarizeBy: none
		sourceColumn: ReturnDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column TerritoryKey
		dataType: int64
		formatString: 0
		lineageTag: 27a75b3f-6197-4585-86af-b6a7ca0d9983
		summarizeBy: none
		sourceColumn: TerritoryKey

		annotation SummarizationSetBy = Automatic

	column ProductKey
